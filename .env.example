# Create a Spotify Web API app and paste its client ID here.
SPOTIFY_CLIENT_ID=

# Create a Discord application and paste its application ID here.
DISCORD_CLIENT_ID=

# This exact URI must also be added to the Spotify app's redirect URIs.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:43821/callback

# Optional tuning.
LINES_PER_UPDATE=2
SPOTIFY_POLL_INTERVAL_MS=3000
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_USER_AGENT=LyricPresence/0.1.0 (personal desktop client)
