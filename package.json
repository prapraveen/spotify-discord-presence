{
  "name": "lyric-presence",
  "version": "0.1.0",
  "private": true,
  "author": "Praveen",
  "description": "Show time-synced lyrics for your current Spotify track in Discord Rich Presence.",
  "type": "module",
  "main": "src/electron.js",
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "start": "node src/index.js",
    "start:env": "node --env-file=.env src/index.js",
    "app": "electron .",
    "dist:mac": "electron-builder --config electron-builder.config.cjs --mac",
    "dist:mac:arm64": "electron-builder --config electron-builder.config.cjs --mac --arm64",
    "dist:mac:x64": "electron-builder --config electron-builder.config.cjs --mac --x64",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/electron.js && node --check src/runtime.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
